# path: book/capstone/northwind-assist/.env.example
# Copy to .env. Defaults run fully offline (fake model, fake embeddings, in-memory stores).
# Never commit .env; production reads secrets from the platform's secret store (k8s/secret.example.yaml).

# ---- models (aie_core)
LLM_PROVIDER=fake                  # openai | anthropic | fake
LLM_MODEL=fake-model
# LLM_BASE_URL=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
EMBEDDING_PROVIDER=fake            # openai | fake
EMBEDDING_MODEL=fake-embedding
# NA_MODEL_MAP={"nw-small": "<model id>", "nw-general": "<model id>", "nw-reasoning": "<model id>", "nw-longctx": "<model id>"}

# ---- auth (JWT)
NA_ENVIRONMENT=dev                 # dev | test | staging | prod
NA_AUTH_MODE=hs256                 # hs256 (dev only) | rs256 | jwks
NA_JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# NA_JWT_PUBLIC_KEY=               # PEM, rs256
# NA_JWKS_URL=https://sso.northwind.example/.well-known/jwks.json
NA_JWT_ISSUER=https://sso.northwind.example
NA_JWT_AUDIENCE=northwind-assist
NA_DEV_LOGIN=true                  # login stub; staging and prod refuse it and the published JWT secret

# ---- knowledge
NA_KNOWLEDGE_BACKEND=local         # local | p3 (Project 3 registry, queue, worker, pgvector)
NA_CANDIDATE_K=30
NA_RERANK_K=12
NA_FINAL_K=6
# DATABASE_URL=postgresql://northwind:northwind@localhost:5432/northwind
# REDIS_URL=redis://localhost:6379/0

# ---- state
NA_IDEMPOTENCY_DB=:memory:
# NA_MEMORY_DB=memory.sqlite
NA_MEMORY_SECRET=dev-only-memory-fingerprint-key
# NA_AUDIT_LOG_PATH=audit.jsonl
# NA_EVENT_DIR=.agent-runs
# NA_COST_LEDGER_PATH=cost.jsonl

# ---- limits and cost (illustrative)
NA_REQUEST_DEADLINE_S=8
NA_ADMISSION_CAPACITY=32
NA_TENANT_REQUESTS_PER_MINUTE=600
NA_TENANT_DAILY_BUDGET_USD={"retail": 25.0, "logistics": 25.0}

# ---- tracing (Chapter 31)
TRACE_SINK=none                    # none | jsonl | otel
TRACE_PATH=traces.jsonl
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
CAPTURE_MODE=hashed                # off | hashed | redacted | full
CAPTURE_SALT=change-me
