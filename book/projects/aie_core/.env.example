# Copy to .env (never commit .env). All variables are optional; defaults run fully offline with fakes.

# Which chat provider to use: openai | anthropic | fake
LLM_PROVIDER=fake
# Model name passed to the provider (no default model names are assumed by the library)
LLM_MODEL=fake-model
# Override for OpenAI-compatible servers (vLLM, Ollama, a gateway) or an Anthropic proxy
# LLM_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Embeddings: openai | fake
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=fake-embedding

# Infrastructure used by later chapters
# DATABASE_URL=postgresql://user:pass@localhost:5432/northwind
# REDIS_URL=redis://localhost:6379/0

# Tracing: none | jsonl | otel
TRACE_SINK=none
TRACE_PATH=traces.jsonl

# Gateway knobs
REQUEST_TIMEOUT_S=60
LLM_MAX_ATTEMPTS=3
LLM_MAX_CONCURRENCY=16
# LLM_REQUESTS_PER_MINUTE=300
# LLM_TOKENS_PER_MINUTE=200000
LLM_RESPONSE_CACHE=false
# LLM_FALLBACK_MODEL=
