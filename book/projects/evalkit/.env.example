# evalkit reads no settings of its own. Judges and targets get their LLM client from aie_core.
# These are the aie_core variables an evaluation run usually sets.
LLM_PROVIDER=fake
LLM_MODEL=fake-model
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# A separate judge model is configured by the caller, for example:
# EVAL_JUDGE_MODEL=judge-model
# EVAL_CONCURRENCY=8
TRACE_SINK=none
