# path: book/projects/examples/ch18/.env.example
# The examples run offline with no configuration. These are read only by aie_core
# if you swap FakeLLM for a real client in demo.py (Chapter 3).
LLM_PROVIDER=fake
LLM_MODEL=fake-model
# The stdio server receives an explicit environment from the client (PATH and
# PYTHONIOENCODING only). It needs no credentials: it reads book/projects/shared-data.
