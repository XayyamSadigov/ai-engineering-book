# path: book/projects/examples/ch31/.env.example
TRACE_SINK=jsonl                 # none | jsonl | otel
TRACE_PATH=traces.jsonl
OTEL_SERVICE_NAME=northwind-assist
OTEL_EXPORTER=otlp               # otlp | console | memory | none (used when TRACE_SINK=otel)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SAMPLE_RATIO=1.0
EMIT_GENAI_ALIASES=false
CAPTURE_MODE=hashed              # off | hashed | redacted | full
CAPTURE_SAMPLE_RATE=0.05
CAPTURE_SALT=replace-with-a-secret-from-your-secret-store
DEPLOY_ENV=dev
APP_VERSION=dev
