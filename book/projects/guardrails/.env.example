# guardrails reads no secrets itself. Model-based checks (LLMInjectionClassifier, LLMModerator)
# use the aie_core client, configured by the standard variables:
LLM_PROVIDER=fake
LLM_MODEL=fake-model
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
TRACE_SINK=none
# Where guardrails.eval finds the Chapter 26 attack corpus (default: ../examples/ch26)
# GUARDRAILS_CH26_DIR=../examples/ch26
