# memorykit reads no settings of its own; the LLM and embedding clients come from aie_core.
LLM_PROVIDER=fake
LLM_MODEL=fake-model
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=fake-embedding
# Path for SQLiteStore in the examples (":memory:" for tests).
MEMORY_DB_PATH=memory.db
# Secret for keyed tombstone fingerprints. Generate per deployment; never commit a real value.
MEMORY_FINGERPRINT_SECRET=change-me
