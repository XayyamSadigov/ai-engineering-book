# Copy to .env (cp env.example .env). Every variable is optional; defaults are shown.

# Model provider (read by aie_core). "fake" runs the offline ReplayLLM over shared-data samples.
LLM_PROVIDER=fake
LLM_MODEL=fake-model
# LLM_BASE_URL=http://localhost:8000/v1
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_FALLBACK_MODEL=
LLM_MAX_ATTEMPTS=3
LLM_MAX_CONCURRENCY=16
# LLM_REQUESTS_PER_MINUTE=
# LLM_TOKENS_PER_MINUTE=
REQUEST_TIMEOUT_S=60

# Tracing (aie_core): none | jsonl | otel
TRACE_SINK=jsonl
TRACE_PATH=data/traces.jsonl

# Extraction service
EXTRACT_ACCEPT_THRESHOLD=0.80
EXTRACT_CLASSIFY_THRESHOLD=0.70
EXTRACT_CLASSIFY_SAMPLES=1
EXTRACT_MAX_SCHEMA_REPAIRS=2
EXTRACT_MAX_RULE_REPAIRS=1
EXTRACT_REQUIRE_PO=true
EXTRACT_DOLLAR_MEANS=USD
EXTRACT_MAX_DOCUMENT_CHARS=50000
EXTRACT_MAX_REQUEST_BYTES=8000000
EXTRACT_MAX_BATCH_SIZE=100
EXTRACT_BATCH_CONCURRENCY=8
EXTRACT_DOCUMENT_DEADLINE_S=120
EXTRACT_CALL_TIMEOUT_S=45
# Authentication. Empty list = OFF (development only). In production inject from a secret store,
# never commit real keys. Roles: submitter, reviewer, admin; tenant null = all tenants.
# EXTRACT_API_KEYS=[{"key":"<from-secret-store>","principal":"retail-ingest","role":"submitter","tenant":"retail"}]
EXTRACT_REVIEW_BACKEND=memory
EXTRACT_REVIEW_DB_PATH=data/review.db
# EXTRACT_SHARED_DATA_DIR=../shared-data
# EXTRACT_GOLD_PATH=../shared-data/invoices.jsonl
