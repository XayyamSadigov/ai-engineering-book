# Project 2: semantic search. Copy to .env and adjust.
# Embeddings (aie_core). "fake" is a deterministic hashing embedder: offline, lexical-ish.
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=fake-embedding
EMBEDDING_DIMENSIONS=256
# OPENAI_API_KEY=...            # only when EMBEDDING_PROVIDER=openai
# LLM_BASE_URL=...              # OpenAI-compatible embedding endpoint (self-hosted, proxy)

# Vector store: "numpy" (exact, file-persisted) or "pgvector"
VECTOR_BACKEND=numpy
INDEX_DIR=.index
# DATABASE_URL=postgresql://northwind:northwind@localhost:5432/northwind
PG_TABLE=chunks
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH=100
HNSW_ITERATIVE_SCAN=relaxed_order

# Index identity: namespace = INDEX_NAME + embedding model + INDEX_VERSION
INDEX_NAME=knowledge
INDEX_VERSION=v1
DOCS_DIR=../shared-data/docs
CHUNK_MAX_CHARS=1200

# Search API
SEARCH_DEFAULT_K=8
SEARCH_MAX_K=50
TRACE_SINK=none
