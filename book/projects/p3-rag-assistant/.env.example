# Copy to .env (docker compose reads it). Defaults run offline with deterministic fakes.

# --- providers (read by aie_core) ---
LLM_PROVIDER=fake                 # fake | openai | anthropic
LLM_MODEL=fake-model
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
EMBEDDING_PROVIDER=fake           # fake (vocabulary mode over the docs) | openai
EMBEDDING_MODEL=fake-embedding
TRACE_SINK=jsonl                  # none | jsonl | otel
TRACE_PATH=/data/traces.jsonl

# --- infrastructure (compose sets these for its services) ---
# DATABASE_URL=postgresql://northwind:northwind@localhost:5432/northwind
# REDIS_URL=redis://localhost:6379/0

# --- assistant (RAG_ prefix) ---
RAG_AUTH_SECRET=change-me-before-anything-but-local-dev
RAG_TENANCY_MODE=shared           # shared | namespace
RAG_RERANKER=lexical              # lexical | cross_encoder | none
RAG_REQUEST_DEADLINE_S=8
RAG_MIN_GENERATION_S=1.5
RAG_ANSWER_CACHE=true
RAG_ANSWER_CACHE_TTL_S=600
RAG_RETRIEVAL_CACHE_TTL_S=300
RAG_FRESHNESS_SLO_S=300
RAG_CONTEXTUAL_ENRICHMENT=false
RAG_TENANT_REQUESTS_PER_MINUTE=600
