# path: book/projects/p4-support-assistant/.env.example
# Model (aie_core). fake = offline keyword demo model, no key needed.
LLM_PROVIDER=fake
LLM_MODEL=fake-model
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_BASE_URL=
TRACE_SINK=none

# Project 4
P4_SHARED_DATA_DIR=../shared-data
P4_ALLOWED_RECIPIENT_DOMAINS=["northwind.example"]
P4_ALLOWED_RECIPIENTS=[]
P4_APPROVAL_TTL_S=900
P4_FOUR_EYES=false
P4_IDEMPOTENCY_DB=:memory:
# P4_AUDIT_LOG_PATH=audit.jsonl
P4_MAX_ROUNDS=6
P4_TOOL_MAX_ATTEMPTS=3
P4_LOOKUP_RATE_PER_MINUTE=20
P4_SEND_RATE_PER_HOUR=30
P4_DEMO_LLM=true
