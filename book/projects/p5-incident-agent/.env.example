# Project 5 configuration. Copy to .env (or export) and adjust. Never commit real keys.
# Model selection (read by aie_core). With LLM_PROVIDER=fake the scripted stand-in model is used.
LLM_PROVIDER=fake
LLM_MODEL=fake-model
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_BASE_URL=
TRACE_SINK=none
TRACE_PATH=traces.jsonl

# Incident agent (read by incident_agent.config.P5Settings)
P5_STATE_DIR=.p5-state
P5_CHANNEL=#incidents
P5_MAX_PLAN_STEPS=8
P5_MAX_REPLANS=2
P5_MAX_REVISIONS=3
P5_MIN_IMPROVEMENT=0.05
P5_JUDGE_PASS_SCORE=4
# P5_JUDGE_MODEL=
P5_STEP_MAX_STEPS=3
P5_STEP_MAX_TOOL_CALLS=2
P5_MAX_LLM_CALLS=60
P5_CHUNK_TOKENS=250
# P5_SHARED_DATA_DIR=../shared-data
# P5_DATA_DIR=./data
