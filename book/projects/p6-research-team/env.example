# Project 6 settings (copy to .env). Every value is optional.
# Model: P6_OFFLINE=true uses the scripted offline policy; false uses aie_core.make_llm_client().
P6_OFFLINE=true
LLM_PROVIDER=fake
LLM_MODEL=fake-model
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Data and logs
# P6_SHARED_DATA_DIR=../shared-data
P6_LOG_DIR=.runs
# Team budget (illustrative defaults)
P6_MAX_TOKENS=80000
# P6_MAX_COST_USD=0.25
P6_DEADLINE_S=120
P6_MAX_CHILDREN=6
P6_MAX_PARALLEL=4
P6_CHILD_MAX_TOKENS=12000
P6_CHILD_MAX_STEPS=6
P6_MAX_ROUNDS=2
# Tracing (aie_core)
TRACE_SINK=none
TRACE_PATH=traces.jsonl
