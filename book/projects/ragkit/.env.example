# ragkit settings (all optional)
RAGKIT_TOKENIZER=regex            # regex | tiktoken
RAGKIT_TIKTOKEN_ENCODING=cl100k_base
RAGKIT_PDF_MIN_CHARS_PER_PAGE=20  # below this a page is flagged needs_ocr
RAGKIT_REQUIRE_ACL=true           # reject documents without tenant and acl_groups
RAGKIT_NEAR_DUPLICATE_THRESHOLD=0.9

# used only by SemanticChunker and the eval script with --embeddings settings (read by aie_core)
EMBEDDING_PROVIDER=fake           # fake | openai
EMBEDDING_MODEL=fake-embedding
# OPENAI_API_KEY=
